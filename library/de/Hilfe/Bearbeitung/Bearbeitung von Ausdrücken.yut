                                "id": "0,55,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Zur bequemen Bearbeitung werden Operationen mit der Zwischenablage unterstützt. Das erlaubt es, ähnliche Ausdrücke schnell einzugeben, Teile von Ausdrücken zu kopieren und in andere Formeln einzufügen.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,56",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,56,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,56,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Für die Arbeit mit der Zwischenablage gibt es Schaltflächen auf der Leiste und Schnelltasten, die im Abschnitt Zwischenablage beschrieben sind.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
