                "level": 1,
                "elements": [
                    {
                        "id": "0,30,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,30,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Symbole in einer Zeile werden einfach gelöscht, wie in Editoren üblich. Man muss den Cursor zum gewünschten Symbol führen und [Entf] drücken, wenn das Symbol rechts steht, oder [Rücktaste], wenn das Symbol links steht.",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
