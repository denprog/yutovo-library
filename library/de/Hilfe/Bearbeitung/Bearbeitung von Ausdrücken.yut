            {
                "id": "0,34",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,34,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,34,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Eine zuvor eingegebene Operation lässt sich löschen. Das Löschen einer Operation bedeutet das Löschen nur des Operationssymbols unter Beibehaltung ihrer Parameter. Diese Aktion erfolgt durch Drücken von [Entf], wenn sich der Cursor in der Position \"vor der Operation\" befindet.",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Standardtext"
