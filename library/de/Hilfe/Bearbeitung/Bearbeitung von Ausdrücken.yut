            {
                "id": "0,68",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,68,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,68,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Der Editor unterstützt das Rückgängigmachen und Wiederholen von Operationen. Das bedeutet, dass bei einer falschen Eingabe die vorherigen Aktionen rückgängig gemacht und später, falls gewünscht, die zuvor rückgängig gemachten wiederholt werden können. Zum Rückgängigmachen einer Aktion dient die Taste [Strg+Z] oder die Schaltfläche ",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            },
                            {
                                "id": "0,68,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,68,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ". Für das Wiederholen die Taste [Strg+Y] oder die Schaltfläche ",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            },
                            {
                                "id": "0,68,0,3",
                                "type": 34,
