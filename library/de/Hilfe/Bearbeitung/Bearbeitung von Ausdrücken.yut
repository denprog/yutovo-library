                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,44",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,44,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,44,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Parameter von Operationen können einen Ausdruck verwenden, der andere Operationen enthält. Für die Eingabe solcher Operationen ist es praktisch, Teile der Formel zu markieren.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,45",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,45,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,45,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Beispiel:",
                                "format_id": "4af04db8-ce10-46a1-838b-0c69dac0f1c7"
                            }
                        ],
                        "format_name": "Beispiel"
                    }
                ],
                "format_name": "Beispiel",
                "format_alignment": 0
            },
            {
                "id": "0,46",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,46,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,46,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nehmen wir den Ausdruck aus dem vorherigen Beispiel und dividieren ihn durch eine Zahl. Markieren Sie ihn dazu zuerst mit der Maus oder den Pfeiltasten. Die Markierung mit den Pfeiltasten erfolgt durch wiederholtes Drücken von [Umschalt+Oben] oder [Umschalt+Unten], bis der gesamte Ausdruck markiert ist. Drücken Sie dann \"/\", um die Divisionsoperation einzugeben.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
