                                "level": 1,
                                "elements": "Beispiel:",
                                "format_id": "024d1211-a16d-4e49-9548-1753392575aa"
                            }
                        ],
                        "format_name": "Beispiel"
                    }
                ],
                "format_name": "Beispiel",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Im nächsten Beispiel wird der Ausdruck von Grund auf, ausgehend von einer leeren Zeile, eingegeben.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
