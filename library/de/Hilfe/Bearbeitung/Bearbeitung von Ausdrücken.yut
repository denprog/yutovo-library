            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die Pfeiltasten ermöglichen die Navigation in Formeln. Der Cursor bewegt sich nach links und rechts (Tasten [Pfeil links] und [Pfeil rechts]) fortlaufend von Formel zu Formel. Bei der Bewegung nach oben ([Pfeil oben]) und unten ([Pfeil unten]) wechselt der Cursor zum nächstgelegenen oberen oder unteren Zweig. Mit [Strg]-[Pfeil links] und [Strg]-[Pfeil rechts] lässt sich der Cursor bewegen, ohne in verschachtelte Elemente einzutreten. Die Taste [Pos1] dient zum Springen des Cursors zum übergeordneten Zweig oder zum Zeilenanfang.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
