            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Bei der Eingabe einer Zahl (Zeile) nimmt der Cursor die Position \"innerhalb der Zeile\" ein und bekommt das Aussehen eines Textcursors. Der Cursor lässt sich mit den Pfeiltasten an eine andere Stelle innerhalb der Zeile bewegen. Drücken Sie: [Links][Links][Links][Links][Links]. Der Cursor wandert fünf Zeichen nach links. Die Eingabe der Zeile erfolgt nun an der neuen Position. Geben Sie ein: \"90\".",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
