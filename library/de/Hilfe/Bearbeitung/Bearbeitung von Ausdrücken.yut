            {
                "id": "0,51",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,51,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,51,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nun ziehen wir die Quadratwurzel aus dem Ausdruck im Nenner. Hier hilft wieder die Markierung. Der Cursor steht jetzt in der äußerst rechten Position; um den Nenner zu markieren, muss also [Umschalt+Links] bis zur vollständigen Markierung dieses Ausdrucks gedrückt werden, oder [Umschalt+Pos1], um die gesamte Zeile zu markieren. Geben Sie dann die Wurzeloperation ein, indem Sie [Umschalt+Strg+Q] drücken.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
