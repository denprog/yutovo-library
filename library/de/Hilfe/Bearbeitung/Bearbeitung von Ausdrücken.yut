            {
                "id": "0,38",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,38,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,38,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Wie man sieht, sind die Parameter – der Wurzelexponent und der Radikand – geblieben, gelöscht wurde nur die Wurzel selbst. Auf analoge Weise lässt sich das Divisionssymbol löschen. Drücken Sie von der vorherigen Position [Oben], um den Cursor auf die Position vor dem Divisionssymbol zu bewegen, und löschen Sie es:",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
