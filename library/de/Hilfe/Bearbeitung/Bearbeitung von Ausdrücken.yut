            {
                "id": "0,60",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,60,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,60,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Der Cursor befindet sich also in der neuen Formel, die vorerst nur eine leere Zeile ist. Bewegen Sie den Cursor auf die obere Formel und markieren Sie die Potenzoperation. Setzen Sie dazu den Cursor (mit den Tasten oder der Maus) vor die gesamte Potenzoperation und drücken Sie [Umschalt+Rechts]. Kopieren Sie dann den markierten Ausdruck in die Zwischenablage, indem Sie [Strg+Einfg] oder die Schaltfläche auf der Werkzeugleiste drücken. Bewegen Sie danach den Cursor auf die untere Formel und fügen Sie den kopierten Ausdruck dort ein, indem Sie [Umschalt+Einfg] oder die Einfügen-Schaltfläche auf der Leiste drücken. Es ergibt sich:",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
