                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,58,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Im vorherigen Beispiel beginnen wir eine neue Formel unter der vorhandenen. Drücken Sie dazu [Enter], wenn der Cursor am Ende der Formel steht. [Enter] bei Cursorposition am Anfang beginnt eine neue Formel über der aktuellen.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
