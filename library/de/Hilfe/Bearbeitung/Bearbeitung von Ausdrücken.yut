                    {
                        "id": "0,43,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,43,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Eingabe von Operationen mit Verwendung der Auswahl",
                                "format_id": "fbf0ad7f-2a3f-4347-be39-be03e2867e74"
                            }
                        ],
                        "format_name": "Überschrift 4"
