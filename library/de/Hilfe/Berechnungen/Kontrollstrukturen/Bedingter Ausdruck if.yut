                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "if(Bedingung, (Anweisung, ...), (Anweisung, ...))",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
