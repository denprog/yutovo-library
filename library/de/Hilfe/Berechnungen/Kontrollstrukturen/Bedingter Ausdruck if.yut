            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die Bedingung x>0 ist wahr, daher wird der erste Zweig ausgeführt und der Wert des Ausdrucks wird zu x. Wird x in eine negative Zahl geändert, wird die Bedingung falsch und der zweite Zweig wird ausgeführt — der Ausdruck gibt -x zurück. Dies ist ein Beispiel für die Berechnung des Betrags einer Zahl.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,8",
