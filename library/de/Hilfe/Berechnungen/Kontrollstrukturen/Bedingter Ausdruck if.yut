            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Eine Zuweisung innerhalb eines Zweigs erstellt eine lokale Variable dieses Zweigs. Im Beispiel liest die Anweisung u=u+1 die äußere Variable u und schreibt das Ergebnis in eine lokale Variable, daher ergibt u*10 den Wert 60. Nach der Berechnung ist die äußere Variable u weiterhin 5 — die dritte Zeile des Beispiels bestätigt das.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,13",
