                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Der bedingte Ausdruck if führt in Abhängigkeit von einer Bedingung einen von zwei Zweigen aus. Diese Kontrollstruktur gibt einen Wert zurück und kann innerhalb anderer Ausdrücke verwendet werden.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
