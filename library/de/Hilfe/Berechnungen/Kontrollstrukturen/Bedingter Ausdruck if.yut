                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ein Zweig ist eine oder mehrere Anweisungen, die in Klammern stehen und durch Kommas getrennt sind. Eine Anweisung kann ein Ausdruck, eine Zuweisung oder eine Funktionsdeklaration sein. Der Wert des if-Ausdrucks ist der Wert der letzten Anweisung des ausgeführten Zweigs. Ein Zweig darf nicht mit einer Funktionsdeklaration enden.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
