                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,14",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,14,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,14,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "In der Bedingung und in den Zweigen können zuvor deklarierte Variablen und Funktionen verwendet werden. Eine innerhalb eines Zweigs deklarierte Funktion ist für die folgenden Anweisungen dieses Zweigs verfügbar und bleibt nach der Berechnung des Ausdrucks erhalten.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
