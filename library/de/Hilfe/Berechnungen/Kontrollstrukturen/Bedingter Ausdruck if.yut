            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die Bedingung ist ein Vergleich zweier Ausdrücke. Unterstützt werden die Operationen <, >, ≤, ≥, = (gleich, wird fetter dargestellt als das Gleichheitszeichen der Berechnung) und ≠ (ungleich). Die Bedingung kann in Klammern gesetzt werden. Die Ausdrücke nach der Bedingung müssen in Klammern stehen.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
