            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die Variable u ist vor der Schleife deklariert und gleich 0. Die Zuweisung u=u+i häuft die Summe an: Bei der ersten Iteration liest die rechte Seite die äußere Variable u, in den folgenden Iterationen den angesammelten Wert.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Anweisungen des Schleifenkörpers",
                                "format_id": "71b8e4a0-82b1-47a6-aadf-ef21fb5b5518"
                            }
                        ],
                        "format_name": "Überschrift 4"
                    }
                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Der Schleifenkörper kann Ausdrücke, Zuweisungen und Funktionsdeklarationen enthalten. Eine Zuweisung erstellt eine lokale Variable der Schleife: Die äußere Variable mit demselben Namen wird nach der Schleife nicht geändert, und der Zähler und die lokalen Variablen existieren nach der Schleife nicht. Eine im Körper deklarierte Funktion ist für die folgenden Anweisungen des Körpers verfügbar und bleibt nach der Schleife erhalten. Die letzte Anweisung des Körpers darf keine Funktionsdeklaration sein; ein leerer Körper ist unzulässig.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
