    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die for-Schleife wiederholt einen Block von Anweisungen, solange die Bedingung wahr ist. Die Anzahl der Wiederholungen wird von einem Zähler gesteuert: Für ihn werden der Anfangswert und ein Ausdruck festgelegt, der nach jeder Iteration berechnet wird. for ist ein Ausdruck: Er gibt einen Wert zurück und kann innerhalb anderer Ausdrücke verwendet werden.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Syntax",
                                "format_id": "71b8e4a0-82b1-47a6-aadf-ef21fb5b5518"
                            }
                        ],
                        "format_name": "Überschrift 4"
                    }
                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "for(Zähler=Anfang, Bedingung, Zähler=Schritt, (Anweisung, ...))",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Zähler=Anfang — Zuweisung des Anfangswerts an den Zähler, zum Beispiel i=1;",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Bedingung — ein Vergleich, der vor jeder Iteration geprüft wird, zum Beispiel i≤10; die Bedingung kann in Klammern gesetzt werden;",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Zähler=Schritt — ein Ausdruck, der nach jeder Iteration berechnet wird, zum Beispiel i=i+1;",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "(Anweisung, ...) — der Schleifenkörper: eine oder mehrere Anweisungen in Klammern, durch Kommas getrennt.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die Schleife läuft so ab: Dem Zähler wird der Anfangswert zugewiesen und die Bedingung wird geprüft; solange die Bedingung wahr ist, wird der Körper ausgeführt und der Schritt berechnet. Der Wert der Schleife ist der Wert der letzten Anweisung des Körpers in der letzten Iteration. Ist die Bedingung schon bei der ersten Prüfung falsch, ist der Wert der Schleife nicht definiert — es entsteht ein Fehler.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
