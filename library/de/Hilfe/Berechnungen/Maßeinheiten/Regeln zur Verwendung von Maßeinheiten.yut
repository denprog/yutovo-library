    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "• Eine Maßeinheit kann erst nach ihrer Deklaration verwendet werden.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Ist die Maßeinheit nicht Teil des SI-Systems, muss bei ihrer Definition und bei ihrer Verwendung im Index der Maßeinheit ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "wird ihr System angegeben.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Das System einer Maßeinheit wird als solches nicht ausdrücklich festgelegt, es wird bei ihrer ersten Verwendung deklariert.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Die Deklaration einer Maßeinheit kann an einer beliebigen Stelle des Dokuments erfolgen.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• Wird eine Maßeinheit ohne Erwähnung des Systems geschrieben, wird das SI-System verwendet.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• Um in einem bestimmten Maßsystem zu rechnen, müssen in diesem System ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,5,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,1,0",
                                "type": 4,
                                "elements": "alle im jeweiligen Ausdruck verwendeten Maßeinheiten deklariert.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "• Wenn dieselbe Maßeinheit mehrmals definiert ist (neu definiert), gilt bei ihrer Verwendung in ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,6,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,1,0",
                                "type": 4,
                                "elements": "Ausdrücken gilt die Reihenfolgeregel: im konkreten Ausdruck wird der Wert ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,6,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,2,0",
                                "type": 4,
                                "elements": "der Maßeinheit verwendet, der sich zuerst über dem jeweiligen Ausdruck befindet.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "• Eingebaute Maßeinheiten können ebenfalls neu definiert werden.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
