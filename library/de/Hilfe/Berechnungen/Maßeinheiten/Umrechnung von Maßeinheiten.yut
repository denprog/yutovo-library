            {
                "id": "0,20",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,20,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,20,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die Maßeinheit des Ergebnisses ist in diesem Fall Meter pro Sekunde. Sie entstand als zusammengesetzte Einheit, da keine gleichwertige Einheit deklariert war. Auf Grundlage einer solchen Maßeinheit und ausgehend von den eingebauten, auf Metern und Sekunden basierenden Einheiten können verschiedene Kombinationen gebildet werden, die im Maßeinheiten-Dialog dargestellt werden. Wählen Sie zum Beispiel \"cm/s\".",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
