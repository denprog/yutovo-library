    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo kann Maßeinheiten von einem Maßsystem in ein anderes umrechnen sowie das Ergebnis in anderen Maßeinheiten desselben Systems darstellen.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die Umrechnung von Maßeinheiten innerhalb eines Systems kann bei der Berechnung des Ausdrucksergebnisses automatisch erfolgen (wenn die Einheit nicht ausdrücklich angegeben ist). Für die Umrechnung des Ergebnisses in ein anderes System muss dieses ausdrücklich angegeben werden.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Die automatische Auswahl der Maßeinheit erfolgt, wenn das Ergebnis eines Ausdrucks zum ersten Mal berechnet wird. Zur Auswahl einer bestimmten Maßeinheit und eines Maßsystems dient das Kontextmenü des Berechnungsergebnisses. In diesem Menü wählt der Benutzer das gewünschte Maßsystem und die Maßeinheit, in die er das Ergebnis umrechnen möchte.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Einfache Maßeinheiten",
                                "format_id": "fc9baea7-a714-4281-b68e-0cab40b2ef83"
                            }
                        ],
                        "format_name": "Überschrift 4"
                    }
                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Beispiel:",
                                "format_id": "fd15aa29-0e34-4511-92e9-eafcc0c796cd"
                            }
                        ],
                        "format_name": "Beispiel"
                    }
                ],
                "format_name": "Beispiel",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Im nächsten Beispiel werden Längeneinheiten verwendet. Da das Maßsystem nicht festgelegt ist, wird das standardmäßige metrische System (SI) verwendet. Bei den Berechnungen erfolgt die automatische Auswahl der am besten geeigneten Maßeinheit. Alle im Beispiel verwendeten Maßeinheiten sind eingebaut.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
