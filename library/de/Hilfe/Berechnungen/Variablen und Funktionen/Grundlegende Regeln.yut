                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Eine Variable oder Funktion muss vor ihrer ersten Verwendung deklariert werden.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "41d21591-2ebf-4ba0-b3f1-79d25d1f10d7"
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Eine Variable oder Funktion kann mehrmals definiert werden. Dies nennt man Neudefinition.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "41d21591-2ebf-4ba0-b3f1-79d25d1f10d7"
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Bei der Neudefinition einer Variable oder Funktion gilt die Regel der Reihenfolge der Ausdrücke im Dokument: im Ausdruck wird die Definition der Variable oder Funktion verwendet, die oben am nächsten steht.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "41d21591-2ebf-4ba0-b3f1-79d25d1f10d7"
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Eine Funktion kann eine beliebige Anzahl an Parametern haben, die durch Kommas getrennt angegeben werden.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "41d21591-2ebf-4ba0-b3f1-79d25d1f10d7"
            },
            {
                "id": "0,4",
                "type": 2,
