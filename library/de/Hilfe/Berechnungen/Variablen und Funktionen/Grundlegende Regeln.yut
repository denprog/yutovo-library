                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Eingebaute Variablen und Funktionen können neu definiert werden.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
