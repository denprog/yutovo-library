                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Wir können personenbezogene Daten des Nutzers erheben, wie Name, E-Mail-Adresse, IP-Adresse und weitere Informationen.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "2. Arten der Informationserhebung",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Wir können Informationen erheben, wenn der Nutzer sich auf der Website registriert, die Registrierung aufhebt, sich anmeldet oder abmeldet.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Wir können personenbezogene Daten erheben, wenn der Nutzer einen der Dienste der Website nutzt.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "3. Verwendung von Informationen",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Wir können Informationen verwenden, um Ihr Benutzerkonto auf der Website zu bestätigen, indem wir eine Bestätigungs-E-Mail an Ihre registrierte E-Mail-Adresse senden.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Wir können personenbezogene Daten zur Beantwortung von Anfragen der Nutzer verwenden. Wir können personenbezogene Daten zur Verbesserung der Dienste, der Website und der Desktop-Anwendung verwenden. Wir können personenbezogene Daten zu Sicherheitszwecken zum Schutz der Nutzer und der Website verwenden. Wir können Informationen verwenden, soweit dies gesetzlich zulässig ist.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "4. Nutzerrechte an Ihren Daten",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Sie können verlangen, dass wir alle personenbezogenen Daten, die wir über Sie speichern, löschen. Dies umfasst nicht Daten, die wir aus administrativen, rechtlichen oder Sicherheitsgründen aufbewahren müssen. Eine Anfrage zur Datenlöschung können Sie an support@yutovo.ru senden.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "5. Haftungsausschluss",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Sie übernehmen die gesamte Verantwortung und das gesamte Risiko im Zusammenhang mit der Nutzung dieser Website, die ohne jegliche Gewährleistungen „wie besehen“ bereitgestellt wird. Auf die über die Website abrufbaren Informationen, einschließlich, aber nicht beschränkt auf alle Inhalte und Materialien sowie die auf unserer Website angebotenen Funktionen und Dienste, wird ohne jegliche Gewährleistungen hingewiesen, einschließlich, aber nicht beschränkt auf Gewährleistungen bezüglich Verfügbarkeit, Genauigkeit, Vollständigkeit oder Nützlichkeit der Inhalte oder Informationen, unterbrechungsfreiem Zugriff sowie jegliche Gewährleistungen bezüglich Eigentum, Nichtverletzung von Rechten, Marktgängigkeit oder Eignung für einen bestimmten Zweck. Wir übernehmen keine Gewähr dafür, dass unsere Website oder ihr Betrieb sowie die Inhalte und Materialien der über sie bereitgestellten Dienste rechtzeitig, sicher, unterbrechungsfrei und fehlerfrei sein werden, dass Fehler behoben werden oder dass unsere Websites oder Server, die den Zugang zu unserer Website ermöglichen, frei von Viren oder anderen schädlichen Komponenten sind. Sie nutzen unsere Website auf eigenes Risiko und übernehmen die volle Verantwortung für alle Kosten, die mit der Nutzung der Website verbunden sind. Wir haften nicht für Schäden im Zusammenhang mit der Nutzung unserer Website.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
