    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Der Dienst yutovo.ru, yutovo.com (nachfolgend Yutovo genannt) und die Desktop-Anwendung werden ohne jegliche Gewährleistungen ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "ausdrücklicher oder stillschweigender Art, für einen beliebigen Zweck, bereitgestellt.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Der Anbieter des Yutovo-Dienstes und der Desktop-Anwendung übernimmt keinerlei Verantwortung, finanzieller oder ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "anderweitiger Art, für Schäden oder Verluste durch die Nutzung des Yutovo-Dienstes oder der Desktop-",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "Anwendung zu übernehmen, einschließlich, aber nicht beschränkt auf Schäden an Hardware und Software ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,3,0",
                                "type": 4,
                                "elements": "Nutzer.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Dokumente, die im Yutovo-Konto gespeichert sind, sind privat für die registrierten ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "Nutzer.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Der Anbieter des Yutovo-Dienstes behält sich das Recht vor, alle hochgeladenen Dokumente, Softwareprotokolle, ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "Berechnungsergebnisse und Eingabedaten innerhalb des Yutovo-Dienstes zum Zweck der Wartung, Entwicklung und ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,2,0",
                                "type": 4,
                                "elements": "des Testens des Yutovo-Dienstes zu verwenden.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Der Anbieter des Yutovo-Dienstes behält sich das Recht vor, diese Nutzungsbedingungen jederzeit zu ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,4,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,1,0",
                                "type": 4,
                                "elements": "ändern.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
