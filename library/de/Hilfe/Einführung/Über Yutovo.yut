    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo ist eine Anwendung zur Lösung verschiedener mathematischer Aufgaben. Yutovo stellt Berechnungen in einer anschaulichen „Papierform“ dar. Es verwendet die allgemein anerkannte mathematische Schreibweise zur Darstellung von Formeln. Yutovo ist sowohl für alltägliche als auch für technische Aufgaben gedacht und eignet sich für einen breiten Kreis von Nutzern in den unterschiedlichsten Tätigkeitsbereichen.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Yutovo verwendet die grafische Darstellung mathematischer Formeln.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Ergebnisse von Berechnungen können eine beliebige Anzahl an Ziffern haben und ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "Genauigkeit",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Berechnungen/Ändern der Ergebnisgenauigkeit.yut"
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ".",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
