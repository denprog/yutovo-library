    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Jedes Dokument hat eine Reihe von Einstellungen, die im Dialog Dokumenteigenschaften festgelegt werden, der über die Schaltfläche ",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ".",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Registerkarte Ergebnis",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ],
                        "format_name": "Überschrift 4"
                    }
                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Hier sind die Standardeinstellungen für die Berechnung von Ausdrücken aufgeführt.",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Automatische Ergebnisauswahl – bei der Berechnung eines Ausdrucks werden die unten in der Tabelle aufgeführten Ergebnistypen nacheinander durchprobiert, bis der Ausdruck erfolgreich berechnet ist. Liefern alle Varianten Fehler, wird der Fehler der ersten Berechnungsvariante zurückgegeben.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Reihenfolge der Ergebnisauswahl – in dieser Reihenfolge werden die Berechnungsvarianten des aktuellen Ausdrucks durchprobiert. Meistens werden Ausdrücke in reellen Zahlen berechnet, deshalb steht diese Variante standardmäßig an erster Stelle. Um zum Beispiel den Ausdruck in erster Linie als echten Bruch darzustellen, setzen Sie Bruch an die erste Stelle.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Reell, Ganzzahl, Bruch, Komplex – auf diesen Registerkarten sind die Standardparameter dieser Ergebnisse dargestellt. Später lassen sie sich für jedes Ergebnis über das Kontextmenü ändern.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Registerkarte Dokument",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ],
                        "format_name": "Überschrift 4"
                    }
                ],
                "format_name": "Überschrift 4",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Sprache – die aktuelle Sprache des Dokuments. Von ihr hängen die Menge der Maßeinheiten und einiger Variablen ab. Zum Beispiel ist für die englische Sprache die imaginäre Einheit \"i\" und für die russische \"j\". Maßeinheiten werden in ihrer jeweiligen Sprache geschrieben.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Tabulator – Tabulatorzeichen oder stattdessen eine bestimmte Anzahl von Leerzeichen verwenden.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Standardtext"
                    }
                ],
                "format_name": "Standardtext",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
