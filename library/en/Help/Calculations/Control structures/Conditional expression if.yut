                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The condition is a comparison of two expressions. The supported operations are <, >, ≤, ≥, = (equal to, displayed bolder than the solving equals sign) and ≠ (not equal to). The condition can be enclosed in parentheses. The expressions after the condition must be in parentheses.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Text body"
                    }
