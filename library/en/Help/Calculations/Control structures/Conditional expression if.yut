                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "An assignment inside a branch creates a local variable of that branch. In the example, the statement u=u+1 reads the outer variable u and writes the result to a local variable, so u*10 gives 60. After the calculation, the outer variable u is still equal to 5 — the third line of the example confirms this.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
