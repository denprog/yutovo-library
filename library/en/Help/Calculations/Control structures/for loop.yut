                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The loop body can contain expressions, assignments and function declarations. An assignment creates a local variable of the loop: the outer variable with the same name is not changed after the loop, and the counter and local variables do not exist after the loop. A function declared in the body is available to the following statements of the body and persists after the loop. The last statement of the body cannot be a function declaration; an empty body is not allowed.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Text body"
                    }
