            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "By clicking on the colored rectangle near a surface expression, you can change the color, the thickness and the display style of the corresponding surface: color by height, solid color, color by height with mesh, wireframe, points.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6"
                            }
                        ],
                        "format_name": "Text body"
                    }
