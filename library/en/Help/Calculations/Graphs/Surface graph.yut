                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "You can rotate the plot with your mouse. Holding Shift, you can move the plot, changing the area bounds. You can zoom the plot with the mouse wheel. You can also resize it by dragging the plot's borders with your mouse. Right-clicking and selecting the Graph menu allows you to change the plot's color and size.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
