                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• Commonly used mathematical functions and constants are supported.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
