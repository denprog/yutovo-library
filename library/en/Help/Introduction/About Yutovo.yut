    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo is an application for solving various mathematical problems. Yutovo has a visual \"paper\" view for calculations. It ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "uses a generally accepted mathematical syntax to display formulas. Yutovo is designed to solve both everyday and ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "engineering tasks and is suitable for a wide range of users across various fields.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Yutovo uses a graphical representation of mathematical formulas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Calculation results can have any number of digits and ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 39,
                                "elements": "accuracy",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Calculations/Result precision adjustment.yut"
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "elements": ".",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Yutovo works with the following types of numbers: ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 39,
                                "elements": "real",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Calculations/Numbers/Real numbers.yut"
                            },
                            {
                                "id": "0,3,0,2",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,3,0,3",
                                "type": 39,
