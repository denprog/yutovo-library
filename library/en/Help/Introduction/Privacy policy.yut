                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "We might collect information when user register, unregister, login or logout to the site. We might collect personal information when user uses any of the services of the site.",
                                "format_id": "530682d4-c835-46f5-a7f0-7d69b3e26b6d"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
