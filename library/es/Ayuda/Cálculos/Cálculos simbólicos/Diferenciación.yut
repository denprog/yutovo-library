                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La función diff calcula la derivada de una expresión respecto a la variable seleccionada. El sistema aplica automáticamente las reglas de diferenciación para todas las funciones y operaciones que entran en la expresión. El resultado se presenta en forma simbólica y puede utilizarse para cálculos o sustituciones posteriores.",
                                "format_id": "0fbf9876-e27a-444d-bc03-0b6df602bce4"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
