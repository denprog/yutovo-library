                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La variable u está declarada antes del bucle y es igual a 0. La asignación u=u+i acumula la suma: en la primera iteración la parte derecha lee la variable externa u, en las iteraciones siguientes, el valor acumulado.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
