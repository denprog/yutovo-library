                                "type": 4,
                                "level": 1,
                                "elements": "Ejemplo:",
                                "format_id": "21a107f6-65f7-4591-bd87-78c562564034"
                            }
                        ],
                        "format_name": "Ejemplo"
                    }
                ],
                "format_name": "Ejemplo",
                "format_alignment": 0
            },
