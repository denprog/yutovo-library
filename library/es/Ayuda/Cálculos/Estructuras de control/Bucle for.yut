            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "El cuerpo del bucle puede contener expresiones, asignaciones y declaraciones de funciones. Una asignación crea una variable local del bucle: la variable externa con el mismo nombre no cambia después del bucle, y el contador y las variables locales no existen después del bucle. Una función declarada en el cuerpo está disponible para las instrucciones siguientes del cuerpo y se conserva después del bucle. La última instrucción del cuerpo no puede ser una declaración de función; un cuerpo vacío no está permitido.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
