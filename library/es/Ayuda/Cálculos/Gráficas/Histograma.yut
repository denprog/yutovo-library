                    {
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "type": 4,
                                "level": 1,
                                "elements": "Al hacer clic en el rectángulo de color cerca de una expresión, puede cambiar el color, el grosor y el estilo de visualización del histograma correspondiente: barras, barras con línea, barras sin huecos, líneas de espectrograma, área bajo la línea, escalones, marcas.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6",
                                "id": "0,5,0,0"
                            }
                        ],
