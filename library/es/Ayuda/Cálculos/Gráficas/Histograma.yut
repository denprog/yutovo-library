                            {
                                "type": 4,
                                "level": 1,
                                "elements": "Para trazar un histograma, haga clic en el botón ",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6",
                                "id": "0,0,0,0"
                            },
                            {
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": "",
                                "id": "0,0,0,1"
                            },
                            {
                                "type": 4,
                                "level": 1,
                                "elements": " de la barra de herramientas Gráficos y luego ingrese un arreglo de valores de barras, por ejemplo [1, 5, 3, 2]. La expresión puede ser cualquier cosa dentro de la sintaxis aceptada y debe evaluar a un arreglo.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6",
                                "id": "0,0,0,2"
