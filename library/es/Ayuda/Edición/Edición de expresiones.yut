                "elements": [
                    {
                        "id": "0,50,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,50,0,0",
                                "type": 4,
                                "elements": "Las líneas \"sin\" y \"cos\" se muestran en un color diferente al de los números. Esto se hace por comodidad. Ahora extraeremos la ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,50,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,50,1,0",
                                "type": 4,
                                "elements": "raíz cuadrada de la expresión en el denominador. Aquí también, la selección será útil. Ahora el cursor está en el extremo derecho, ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,50,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,50,2,0",
                                "type": 4,
                                "elements": "así que para seleccionar el denominador, debe presionar [Mayús+Izquierda] hasta que la expresión esté completamente ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,50,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,50,3,0",
                                "type": 4,
                                "elements": "seleccionada, o [Mayús+Inicio] para seleccionar toda la línea. Luego, introduzca la operación de extracción de raíz presionando ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,50,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,50,4,0",
                                "type": 4,
                                "elements": "[Mayús+Ctrl+Q].",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
