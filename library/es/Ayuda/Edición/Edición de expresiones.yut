                    {
                        "id": "0,46,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,46,0,0",
                                "type": 4,
                                "elements": "En la expresión del ejemplo anterior dividámosla por un número. Para ello, primero selecciónela con el ratón o las teclas del ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
