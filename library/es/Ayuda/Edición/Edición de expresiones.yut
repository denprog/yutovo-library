                        "id": "0,46,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,46,1,0",
                                "type": 4,
                                "elements": "cursor. La selección con las teclas del cursor se realiza pulsando sucesivamente [Mayús+Arriba] o [Mayús+Abajo] hasta ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,46,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,46,2,0",
                                "type": 4,
                                "elements": "seleccionar toda la expresión. A continuación, pulse \"/\" para introducir la operación de división.",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    }
                ],
