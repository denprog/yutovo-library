            },
            {
                "id": "0,54",
                "type": 2,
                "elements": [
                    {
                        "id": "0,54,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,54,0,0",
                                "type": 4,
                                "elements": "Para facilitar la edición, se admiten operaciones con el portapapeles. Esto permite introducir rápidamente expresiones similares, ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,54,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,54,1,0",
                                "type": 4,
                                "elements": "copiar partes de expresiones y pegarlas en otras fórmulas.",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,55",
                "type": 2,
                "elements": [
                    {
                        "id": "0,55,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,55,0,0",
                                "type": 4,
                                "elements": "Para trabajar con el portapapeles, hay botones en el panel y teclas de acceso rápido que se describen en la sección ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
