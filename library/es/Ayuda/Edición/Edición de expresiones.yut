            {
                "id": "0,59",
                "type": 2,
                "elements": [
                    {
                        "id": "0,59,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,59,0,0",
                                "type": 4,
                                "elements": "El cursor se encuentra en una nueva fórmula, actualmente representada solo por una línea vacía. Mueva el cursor a la fórmula ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,59,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,59,1,0",
                                "type": 4,
                                "elements": "superior y seleccione la operación exponencial. Para ello, coloque el cursor (con las teclas o el ratón) antes de la operación ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,59,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,59,2,0",
                                "type": 4,
                                "elements": "exponencial y pulse [Mayús+Derecha]. A continuación, copie la expresión seleccionada al búfer pulsando [Ctrl+Insert] o el botón ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,59,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,59,3,0",
                                "type": 4,
                                "elements": "de la barra de herramientas. A continuación, mueva el cursor a la fórmula inferior y pegue allí la expresión copiada pulsando ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,59,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,59,4,0",
                                "type": 4,
                                "elements": "[Mayús+Insert] o el botón de pegar de la barra de herramientas. Obtendrá:",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    }
                ],
