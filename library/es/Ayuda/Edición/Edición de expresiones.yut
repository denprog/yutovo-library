            {
                "id": "0,38",
                "type": 2,
                "elements": [
                    {
                        "id": "0,38,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,38,0,0",
                                "type": 4,
                                "elements": "Como puede ver, los parámetros (el grado de la raíz y la expresión radical) se conservan; solo se elimina la raíz. El símbolo de ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,38,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,38,1,0",
                                "type": 4,
                                "elements": "división se puede eliminar de forma similar. Desde la posición anterior, pulse [Arriba] para mover el cursor hasta la posición ",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    },
                    {
                        "id": "0,38,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,38,2,0",
                                "type": 4,
                                "elements": "anterior al símbolo de división y eliminarlo.",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
