                        "type": 3,
                        "elements": [
                            {
                                "id": "0,34,1,0",
                                "type": 4,
                                "elements": "operación, conservando sus parámetros. Para ello, pulse [Del] cuando el cursor esté en la posición \"antes de la operación\".",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ]
                    }
                ],
