    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo es una aplicación para resolver diversos problemas matemáticos. Yutovo ofrece una vista visual en papel para los ",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "cálculos. Utiliza una sintaxis matemática generalmente aceptada para mostrar las fórmulas. Yutovo está diseñado para ",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "resolver tanto tareas cotidianas como de ingeniería y es adecuado para una amplia variedad de usuarios en diferentes ",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            }
                        ]
                    },
                    {
                        "id": "0,0,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,3,0",
                                "type": 4,
                                "elements": "ámbitos.",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Yutovo utiliza una representación gráfica de fórmulas matemáticas.",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Los resultados de los cálculos pueden tener cualquier número de dígitos y ",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 39,
                                "elements": "precisión",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Cálculos/Cambiar la precisión del resultado.yut"
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "elements": ".",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Yutovo trabaja con los siguientes tipos de números: ",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 39,
                                "elements": "reales",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Cálculos/Números/Números reales.yut"
                            },
                            {
                                "id": "0,3,0,2",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,3,0,3",
                                "type": 39,
                                "elements": "enteros",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Cálculos/Números/Números enteros.yut"
                            },
                            {
