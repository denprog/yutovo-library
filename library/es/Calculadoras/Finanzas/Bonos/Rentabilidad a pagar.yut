                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "La Calculadora de rendimiento por vencimiento calcula el rendimiento anual total de un bono cuando se compra al precio actual, se guarda hasta la fecha de vencimiento y se reinvierten todos los pagos de ",
                                "format_id": "37f49047-3b61-4521-9bc2-cd3155beb4e1"
                            }
