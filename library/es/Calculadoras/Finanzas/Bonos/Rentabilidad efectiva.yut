                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "La Calculadora de rendimiento efectivo con reinversión calcula el rendimiento total de un bono, teniendo en cuenta los pagos de cupones, así como la reinversión (capitalización) de cupones a la misma tasa ",
                                "format_id": "40be85fb-337d-45d3-b606-efbfe15691b2"
                            }
                        ]
