                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo es una calculadora poderosa con la visualización y edición gráfica habitual de operaciones matemáticas dentro de un editor de texto. Con él, puede hacer varios cálculos combinando cálculos y texto ",
                                "format_id": "396fbeaf-b664-4247-9b8a-3de1b8226fc0"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "en un solo documento, a saber:",
                                "format_id": "396fbeaf-b664-4247-9b8a-3de1b8226fc0"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
