                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Calcular expresiones de cualquier tamaño con cualquier precisión. Para seleccionar el número de decimales y el orden, haga clic con el botón derecho en el resultado y seleccione \"Precisión\" u \"Orden\":",
                                "format_id": "396fbeaf-b664-4247-9b8a-3de1b8226fc0"
                            }
                        ]
                    }
