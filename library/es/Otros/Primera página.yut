    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo es una calculadora multifuncional con una interfaz visual intuitiva y la posibilidad de editar operaciones matemáticas, además de contar con un editor de texto. Permite realizar diversos cálculos, combinando fórmulas y texto en un mismo documento. Tras registrarte en la ",
                                "format_id": "b15cb7a8-f28a-4b99-84cf-b94f31f4110d"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "web",
                                "format_id": "6359f7cb-cb92-4df7-9219-546de12b37eb",
                                "url": "https://yutovo.com"
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ", puedes guardar tus documentos en la nube y compartir tus cálculos con otros usuarios.",
                                "format_id": "b15cb7a8-f28a-4b99-84cf-b94f31f4110d"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Estas son sus principales características:",
                                "format_id": "b15cb7a8-f28a-4b99-84cf-b94f31f4110d"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Calcular expresiones de cualquier tamaño con cualquier precisión",
                                "format_id": "ad0f2973-c6b3-4d9e-9f4b-a8398b44d62d"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 4,
                                "level": 1,
                                "elements": ". Para seleccionar el número de decimales y el orden, haga clic con el botón derecho en el resultado y seleccione \"Precisión\" u \"Orden\":",
                                "format_id": "396fbeaf-b664-4247-9b8a-3de1b8226fc0"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
