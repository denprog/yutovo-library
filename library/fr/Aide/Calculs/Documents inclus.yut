    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Les documents inclus servent à ajouter au document courant les variables, fonctions et unités ",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "déclarées dans le document inclus. Pour inclure un document (ou plusieurs), cliquez sur le bouton « Paramètres » ",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,2,1",
                                "type": 4,
                                "elements": "et choisissez l'onglet « Documents inclus ». Ajoutez ensuite les documents à la liste.",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "La recherche du document inclus se déroule comme suit. Si l'utilisateur n'est pas connecté et si le document ",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "courant est un document utilisateur, la recherche part de la racine de la bibliothèque. Si l'utilisateur ",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "est connecté, on cherche d'abord un document utilisateur portant ce nom, puis la recherche se poursuit dans la bibliothèque.",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Ensuite, après l'inclusion réussie du document, les identificateurs du document inclus pourront être utilisés ",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "dans le document courant.",
                                "format_id": "409b45aa-a9a8-409b-8d71-d7da1de45983"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
