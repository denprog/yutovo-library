                        "elements": [
                            {
                                "id": "0,7,1,0",
                                "type": 4,
                                "elements": "rectangles délimitants, qui aident à comprendre qu'il s'agit d'expressions différentes. Par exemple, ici l'expression « -cos(c) » se trouve en ",
                                "format_id": "95de41a0-fcad-49fa-b9c8-b26ecc074363"
                            }
                        ]
                    },
