                        "elements": [
                            {
                                "id": "0,7,2,0",
                                "type": 4,
                                "elements": "dehors de l'opération d'affectation, elle ne participe donc pas au calcul de la fonction y. Cela s'est produit parce qu'au moment de la saisie de « - », le ",
                                "format_id": "95de41a0-fcad-49fa-b9c8-b26ecc074363"
                            }
                        ]
                    },
