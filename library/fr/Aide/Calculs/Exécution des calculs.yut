                            {
                                "id": "0,7,3,0",
                                "type": 4,
                                "elements": "curseur se trouvait en dehors de l'affectation.",
                                "format_id": "95de41a0-fcad-49fa-b9c8-b26ecc074363"
                            }
                        ]
                    }
