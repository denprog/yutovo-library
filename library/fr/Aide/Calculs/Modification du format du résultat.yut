    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "La sélection automatique du type de résultat est d'abord utilisée pour calculer l'expression. Cependant, pour des raisons de commodité ",
                                "format_id": "bde05625-628f-4a77-bd87-cfe0843b9b5a"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "de représentation, le type de résultat calculé, placé après le signe égal, peut être modifié. Pour cela, ",
                                "format_id": "bde05625-628f-4a77-bd87-cfe0843b9b5a"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "par un clic droit sur le résultat, choisissez dans le sous-menu « Représenter comme » le type de résultat souhaité.",
                                "format_id": "bde05625-628f-4a77-bd87-cfe0843b9b5a"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Exemple :",
                                "format_id": "866d8093-18e9-4045-bed8-07ff0f453430"
                            }
                        ]
                    }
                ],
                "format_name": "Exemple",
                "format_alignment": 0
            },
            {
