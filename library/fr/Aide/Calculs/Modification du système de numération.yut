                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Les paramètres des nombres entiers permettent de définir le système de numération par défaut et le système de numération du résultat. Pour ",
                                "format_id": "46bf57c9-7b11-4eeb-9d04-0bf6b84900cc"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "des calculs précis, le système de numération peut être choisi séparément.",
                                "format_id": "46bf57c9-7b11-4eeb-9d04-0bf6b84900cc"
                            }
                        ]
