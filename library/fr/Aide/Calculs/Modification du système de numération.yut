                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Le changement de système de numération n'est possible que pour les nombres entiers.",
                                "format_id": "46bf57c9-7b11-4eeb-9d04-0bf6b84900cc"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
