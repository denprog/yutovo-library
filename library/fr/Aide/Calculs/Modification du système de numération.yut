            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Quatre systèmes de numération sont pris en charge : binaire (bin), octal (oct), décimal (dec), hexadécimal ",
                                "format_id": "dc7bb92a-3900-4747-a307-0dc13ad3a636"
                            }
                        ]
                    },
