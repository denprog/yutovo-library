                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Instructions du corps de la boucle",
                                "format_id": "71b8e4a0-82b1-47a6-aadf-ef21fb5b5518"
                            }
                        ],
                        "format_name": "Titre 4"
                    }
                ],
                "format_name": "Titre 4",
                "format_alignment": 0
            },
            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Le corps de la boucle peut contenir des expressions, des affectations et des déclarations de fonctions. Une affectation crée une variable locale de la boucle : la variable externe du même nom n'est pas modifiée après la boucle, et le compteur et les variables locales n'existent plus après la boucle. Une fonction déclarée dans le corps est disponible pour les instructions suivantes du corps et est conservée après la boucle. La dernière instruction du corps ne peut pas être une déclaration de fonction ; un corps vide n'est pas autorisé.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
