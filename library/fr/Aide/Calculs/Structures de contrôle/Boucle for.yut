            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La variable u est déclarée avant la boucle et vaut 0. L'affectation u=u+i accumule la somme : à la première itération, la partie droite lit la variable externe u ; aux itérations suivantes, la valeur accumulée.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,11",
