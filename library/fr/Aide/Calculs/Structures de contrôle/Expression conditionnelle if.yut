            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La condition x>0 est vraie, donc la première branche est exécutée et la valeur de l'expression devient x. Si l'on remplace x par un nombre négatif, la condition devient fausse et la seconde branche est exécutée — l'expression renvoie -x. C'est un exemple de calcul de la valeur absolue d'un nombre.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
