            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La condition est une comparaison de deux expressions. Les opérations prises en charge sont <, >, ≤, ≥, = (égal, affiché en plus gras que le signe égal de calcul) et ≠ (différent de). La condition peut être mise entre parenthèses. Les expressions après la condition doivent être entre parenthèses.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
