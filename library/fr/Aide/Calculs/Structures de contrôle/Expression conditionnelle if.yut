                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Une branche est une ou plusieurs instructions placées entre parenthèses et séparées par des virgules. Une instruction peut être une expression, une affectation ou une déclaration de fonction. La valeur de l'expression if est la valeur de la dernière instruction de la branche exécutée. Une branche ne peut pas se terminer par une déclaration de fonction.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
