                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Une affectation à l'intérieur d'une branche crée une variable locale de cette branche. Dans l'exemple, l'instruction u=u+1 lit la variable externe u et écrit le résultat dans une variable locale, donc u*10 donne 60. Après le calcul, la variable externe u est toujours égale à 5 — la troisième ligne de l'exemple le confirme.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
