                        "level": 1,
                        "elements": [
                            {
                                "id": "0,20,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La mesure du résultat est dans ce cas des mètres par seconde. Elle est devenue composée car aucune unité équivalente n'avait été déclarée. Sur la base d'une telle unité et à partir des unités intégrées fondées sur le mètre et la seconde, diverses combinaisons peuvent être formées, qui seront présentées dans la boîte de dialogue des unités. Choisissez par exemple « cm/s ».",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
