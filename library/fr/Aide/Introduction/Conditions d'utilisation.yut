    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Le service yutovo.ru, yutovo.com (ci-après dénommé Yutovo) et l'application de bureau ne fournissent aucune garantie, ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "expresse ou implicite, pour quelque usage que ce soit.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Le fournisseur du service Yutovo et de l'application de bureau n'assume aucune responsabilité, financière ou ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "autre, pour tout dommage ou perte résultant de l'utilisation du service Yutovo ou de l'application de ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "bureau, y compris, sans s'y limiter, les dommages causés au matériel et aux logiciels ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,3,0",
                                "type": 4,
                                "elements": "de l'Utilisateur.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Les documents enregistrés dans le compte Yutovo sont personnels pour les ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "utilisateurs inscrits.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Le fournisseur du service Yutovo se réserve le droit d'utiliser tous les documents téléversés, les journaux ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "du programme, les résultats des calculs et les données saisies dans le service Yutovo, à des fins de maintenance, de développement et de ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,2,0",
                                "type": 4,
                                "elements": "test du service Yutovo.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Le fournisseur du service Yutovo se réserve le droit de modifier les présentes Conditions d'utilisation à tout ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,4,1",
                        "type": 3,
