                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "1. Informations collectées",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nous pouvons collecter des informations personnelles sur l'utilisateur, telles que le nom, l'adresse électronique, l'adresse IP et d'autres informations.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "2. Méthodes de collecte des informations",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nous pouvons collecter des informations lorsque l'utilisateur s'inscrit, annule son inscription, se connecte ou se déconnecte du site.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nous pouvons collecter des informations personnelles lorsque l'utilisateur utilise l'un des services du site.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "3. Utilisation des informations",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nous pouvons utiliser les informations pour vérifier votre compte sur le site web en envoyant un e-mail de confirmation à votre adresse électronique enregistrée.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nous pouvons utiliser les informations personnelles pour répondre aux demandes des utilisateurs. Nous pouvons utiliser les informations personnelles pour améliorer les services, le site web et l'application de bureau. Nous pouvons utiliser les informations personnelles à des fins de sécurité pour protéger les utilisateurs et le site web. Nous pouvons utiliser les informations si la loi le permet.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "4. Droits de l'utilisateur sur ses données",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Vous pouvez exiger que nous supprimions toute donnée personnelle que nous détenons à votre sujet. Cela ne comprend pas les données que nous sommes tenus de conserver à des fins administratives, juridiques ou de sécurité. Vous pouvez envoyer une demande de suppression de données sur le site support@yutovo.ru.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "5. Clause de non-responsabilité",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Vous assumez l'entière responsabilité et tous les risques liés à votre utilisation du site web, qui est fourni « en l'état » sans aucune garantie. Les informations accessibles par le biais du site web, y compris, sans s'y limiter, tout le contenu et les documents, ainsi que les fonctions et services présentés sur notre site web, sont tous fournis sans aucune garantie, y compris, sans s'y limiter, des garanties de disponibilité, d'exactitude, d'exhaustivité ou d'utilité du contenu ou des informations, de continuité d'accès et toute garantie de droit de propriété, de non-violation, de qualité marchande ou d'adéquation à un usage particulier. Nous ne garantissons pas que notre site web ou son fonctionnement, ni le contenu et les documents des services qu'il fournit seront opportuns, sûrs, ininterrompus et exempts d'erreurs, que les défauts seront corrigés ou que nos sites web ou serveurs donnant accès à notre site ne contiennent pas de virus ou d'autres composants nuisibles. Vous utilisez notre site web à vos risques et périls et vous assumez l'entière responsabilité de tous les frais liés à votre utilisation du site web. Nous déclinons toute responsabilité pour tout dommage lié à l'utilisation de notre site web.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,12",
