    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Le bloc de calcul est un rectangle dans le texte pour effectuer des calculs. Il apparaît au début d'un document vide et peut ensuite être ajouté à n'importe quel endroit du document (sauf à l'intérieur d'un bloc de code) à l'aide du bouton « Insérer un calculateur » ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " ou par la combinaison de touches [Ctrl+Shift+C]. Le bloc de calcul apparaît également au début de la saisie de code avec les boutons du panneau mathématique, si le curseur ne se trouve pas à ce moment-là dans le code.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Il peut y avoir autant de blocs de calcul que souhaité et ils forment ensemble un espace de calcul unique. Cela signifie en particulier que les variables et fonctions déclarées dans un bloc supérieur peuvent être utilisées dans un bloc inférieur.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ces blocs peuvent être copiés dans le presse-papiers comme n'importe quels autres symboles. Si une expression mathématique du bloc est copiée dans le texte, un nouveau bloc de calcul apparaît automatiquement.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Le texte en dehors de ces blocs n'a aucune influence sur les calculs.",
                                "format_id": "5695a9fc-bfb2-400e-9cf7-a97c96761c88"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
