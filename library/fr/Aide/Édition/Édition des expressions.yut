                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La saisie des expressions mathématiques se fait par simple frappe au clavier, avec les raccourcis clavier ou le panneau d'outils mathématique.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
