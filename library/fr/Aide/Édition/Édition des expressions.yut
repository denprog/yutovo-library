            {
                "id": "0,55",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,55,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,55,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Pour des raisons de commodité d'édition, les opérations avec le presse-papiers sont prises en charge. Cela permet de saisir rapidement des expressions similaires, de copier des parties d'expressions et de les coller dans d'autres formules.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
            {
                "id": "0,56",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,56,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,56,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Pour travailler avec le presse-papiers, des boutons sont prévus dans le panneau et des raccourcis clavier, décrits dans la section Presse-papiers.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
