                    {
                        "id": "0,51,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,51,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Extrayons maintenant la racine carrée de l'expression du dénominateur. La sélection aide encore ici. Le curseur est à la position la plus à droite ; donc, pour sélectionner le dénominateur, il faut appuyer sur [Shift+Left] jusqu'à la sélection complète de cette expression, ou sur [Shift+Home] pour sélectionner toute la chaîne. Saisissez ensuite l'opération d'extraction de la racine en appuyant sur [Shift+Ctrl+Q].",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
