                        "level": 1,
                        "elements": [
                            {
                                "id": "0,60,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Donc, le curseur se trouve dans la nouvelle formule, pour l'instant représentée seulement par une chaîne vide. Déplacez le curseur sur la formule supérieure et sélectionnez l'opération de puissance. Pour cela, il faut placer le curseur (avec les touches ou la souris) avant toute l'opération d'élévation à la puissance et appuyer sur [Shift+Right]. Copiez ensuite l'expression sélectionnée dans le presse-papiers en appuyant sur [Ctrl+Ins], ou avec le bouton de la barre d'outils. Déplacez ensuite le curseur sur la formule inférieure et collez-y l'expression copiée en appuyant sur [Shift+Ins] ou sur le bouton de collage du panneau. On obtient :",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
