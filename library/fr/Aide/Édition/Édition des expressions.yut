                            {
                                "id": "0,58,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Dans l'exemple précédent, commençons une nouvelle formule sous celle existante. Pour cela, appuyez sur [Enter], lorsque le curseur est à la fin de la formule. Appuyer sur [Enter] avec le curseur au début commencera une nouvelle formule au-dessus de la formule courante.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
