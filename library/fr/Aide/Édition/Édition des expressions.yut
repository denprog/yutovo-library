                    {
                        "id": "0,30,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,30,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Les symboles dans une chaîne se suppriment simplement, comme il est d'usage dans les éditeurs. Il faut amener le curseur sur le symbole souhaité et appuyer sur [Del], si le symbole est à droite, ou [Backspace], si le symbole est à gauche.",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
