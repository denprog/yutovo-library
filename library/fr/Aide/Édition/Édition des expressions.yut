            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Lors de la saisie d'un nombre (chaîne), le curseur prend la position « à l'intérieur de la chaîne » et prend l'aspect d'un curseur de texte. Le curseur peut être déplacé avec les touches fléchées vers une autre position dans la chaîne. Appuyez sur : [Left][Left][Left][Left][Left]. Le curseur se déplacera de cinq symboles vers la gauche. La saisie de la chaîne se fera maintenant au nouvel emplacement. Saisissez : « 90 ».",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Corps de texte"
                    }
                ],
                "format_name": "Corps de texte",
                "format_alignment": 0
            },
