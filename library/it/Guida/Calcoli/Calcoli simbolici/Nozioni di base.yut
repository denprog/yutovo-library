    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo permette di calcolare espressioni nella loro forma simbolica formale. Il calcolo simbolico è l'ambito della matematica informatica in cui i programmi lavorano non con numeri, ma con espressioni matematiche nella loro forma simbolica esatta. Se i calcoli numerici ordinari forniscono un risultato sotto forma di numero, nel calcolo simbolico, al posto di valori approssimati, ottenete un risultato analitico — una formula che si può analizzare, semplificare o sostituire in altre espressioni.",
                                "format_id": "193a841a-3f3b-44c3-b14b-1a252da5a042"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Questo approccio permette di evitare errori di arrotondamento a ogni passo dei calcoli. Il risultato rimane matematicamente esatto per tutta la durata del lavoro, e il passaggio al numero decimale avviene solo su vostra richiesta, con la precisione che definite.",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "In Yutovo i calcoli simbolici sono implementati sulla base della libreria SymEngine. Potete eseguire calcoli in tre ambiti: con numeri reali, con frazioni razionali esatte e con numeri complessi, dove si usa l'unità immaginaria.",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Attualmente sono supportate le seguenti operazioni simboliche: ",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "semplificazione",
                                "format_id": "780404af-7b15-4d77-ba74-bc95954d4090",
                                "url": "./Semplificazione.yut"
                            },
                            {
                                "id": "0,3,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ", ",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            },
                            {
                                "id": "0,3,0,3",
                                "type": 39,
                                "level": 1,
                                "elements": "evalf - ottenimento di un valore numerico",
                                "format_id": "780404af-7b15-4d77-ba74-bc95954d4090",
                                "url": "./Ottenimento di un valore numerico.yut"
                            },
                            {
