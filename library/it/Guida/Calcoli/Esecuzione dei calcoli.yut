                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "Se su una riga del blocco calcolatrice si trova più di un'espressione, esse saranno visivamente separate da rettangoli ",
                                "format_id": "95de41a0-fcad-49fa-b9c8-b26ecc074363"
                            }
                        ]
                    },
                    {
                        "id": "0,7,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,1,0",
                                "type": 4,
                                "elements": "delimitanti, che aiutano a capire che si tratta di espressioni diverse. Ad esempio, qui l'espressione « -cos(c) » si trova fuori ",
                                "format_id": "95de41a0-fcad-49fa-b9c8-b26ecc074363"
                            }
                        ]
                    },
                    {
                        "id": "0,7,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,2,0",
                                "type": 4,
                                "elements": "dall'operazione di assegnazione, quindi non partecipa al calcolo della funzione y. Ciò è accaduto perché, al momento dell'inserimento di « - », il ",
                                "format_id": "95de41a0-fcad-49fa-b9c8-b26ecc074363"
                            }
                        ]
                    },
                    {
                        "id": "0,7,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,3,0",
                                "type": 4,
                                "elements": "cursore si trovava fuori dall'assegnazione.",
                                "format_id": "95de41a0-fcad-49fa-b9c8-b26ecc074363"
                            }
                        ]
                    }
                ],
