            },
            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La variabile u è dichiarata prima del ciclo ed è uguale a 0. L'assegnazione u=u+i accumula la somma: alla prima iterazione la parte destra legge la variabile esterna u, nelle iterazioni successive il valore accumulato.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Istruzioni del corpo del ciclo",
                                "format_id": "71b8e4a0-82b1-47a6-aadf-ef21fb5b5518"
                            }
                        ],
                        "format_name": "Titolo 4"
                    }
                ],
                "format_name": "Titolo 4",
                "format_alignment": 0
            },
            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Il corpo del ciclo può contenere espressioni, assegnazioni e dichiarazioni di funzioni. Un'assegnazione crea una variabile locale del ciclo: la variabile esterna con lo stesso nome non cambia dopo il ciclo, mentre il contatore e le variabili locali non esistono dopo il ciclo. Una funzione dichiarata nel corpo è disponibile per le istruzioni successive del corpo e viene conservata dopo il ciclo. L'ultima istruzione del corpo non può essere una dichiarazione di funzione; un corpo vuoto non è ammesso.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
