    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Il ciclo for ripete un blocco di istruzioni finché la condizione è vera. Il numero di ripetizioni è controllato da un contatore: per esso vengono definiti il valore iniziale e un'espressione calcolata dopo ogni iterazione. for è un'espressione: restituisce un valore e può essere usata all'interno di altre espressioni.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Sintassi",
                                "format_id": "71b8e4a0-82b1-47a6-aadf-ef21fb5b5518"
                            }
                        ],
                        "format_name": "Titolo 4"
                    }
                ],
                "format_name": "Titolo 4",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "for(contatore=inizio, condizione, contatore=passo, (istruzione, ...))",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "contatore=inizio — assegnazione del valore iniziale al contatore, per esempio i=1;",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "condizione — un confronto verificato prima di ogni iterazione, per esempio i≤10; la condizione può essere racchiusa tra parentesi tonde;",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "contatore=passo — un'espressione calcolata dopo ogni iterazione, per esempio i=i+1;",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "(istruzione, ...) — il corpo del ciclo: una o più istruzioni tra parentesi tonde, separate da virgole.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Il ciclo viene eseguito così: al contatore viene assegnato il valore iniziale e la condizione viene verificata; finché la condizione è vera, il corpo viene eseguito e il passo viene calcolato. Il valore del ciclo è il valore dell'ultima istruzione del corpo nell'ultima iterazione. Se la condizione è già falsa alla prima verifica, il valore del ciclo non è definito — si verifica un errore.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Esempio:",
                                "format_id": "21a107f6-65f7-4591-bd87-78c562564034"
                            }
                        ],
                        "format_name": "Esempio"
                    }
                ],
                "format_name": "Esempio",
                "format_alignment": 0
            },
