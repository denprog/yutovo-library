                        "level": 1,
                        "elements": [
                            {
                                "id": "0,14,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nella condizione e nei rami si possono usare variabili e funzioni dichiarate in precedenza. Una funzione dichiarata dentro un ramo è disponibile per le istruzioni successive di quel ramo e viene conservata dopo il calcolo dell'espressione.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
