                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La condizione è un confronto tra due espressioni. Sono supportate le operazioni <, >, ≤, ≥, = (uguale, mostrato più marcato rispetto al segno di uguale del calcolo) e ≠ (diverso da). La condizione può essere racchiusa tra parentesi tonde. Le espressioni dopo la condizione devono essere tra parentesi tonde.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
