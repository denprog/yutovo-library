            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Un'assegnazione dentro un ramo crea una variabile locale di quel ramo. Nell'esempio, l'istruzione u=u+1 legge la variabile esterna u e scrive il risultato in una variabile locale, quindi u*10 dà 60. Dopo il calcolo, la variabile esterna u è ancora uguale a 5 — la terza riga dell'esempio lo conferma.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
