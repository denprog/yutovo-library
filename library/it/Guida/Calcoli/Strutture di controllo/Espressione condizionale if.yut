            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La condizione x>0 è vera, quindi viene eseguito il primo ramo e il valore dell'espressione diventa x. Se si cambia x con un numero negativo, la condizione diventa falsa e viene eseguito il secondo ramo — l'espressione restituisce -x. Questo è un esempio di calcolo del valore assoluto di un numero.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
