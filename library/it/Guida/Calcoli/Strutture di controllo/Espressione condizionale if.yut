                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Un ramo è una o più istruzioni racchiuse tra parentesi tonde e separate da virgole. Un'istruzione può essere un'espressione, un'assegnazione o una dichiarazione di funzione. Il valore dell'espressione if è il valore dell'ultima istruzione del ramo eseguito. Un ramo non può terminare con una dichiarazione di funzione.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
