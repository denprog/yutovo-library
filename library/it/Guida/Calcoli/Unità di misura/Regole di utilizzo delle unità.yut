    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "• Un'unità può essere utilizzata solo dopo la sua dichiarazione.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Se l'unità non appartiene al sistema SI, allora nella sua definizione e nel suo utilizzo il suo sistema è ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "indicato nell'indice dell'unità.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Il sistema di un'unità in quanto tale non è definito esplicitamente, esso è dichiarato al suo primo utilizzo.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• La dichiarazione di un'unità può avvenire in qualsiasi punto del documento.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• Se l'unità è scritta senza menzione del sistema, si usa il sistema SI.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• Per eseguire calcoli in un sistema di unità determinato, occorre che in tale sistema siano ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,5,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,1,0",
                                "type": 4,
                                "elements": "dichiarate tutte le unità utilizzate in questa espressione.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "• Se una stessa unità è definita più di una volta (ridefinita), al suo utilizzo nelle espressioni si applica ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,6,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,1,0",
                                "type": 4,
                                "elements": "la regola dell'ordine: nell'espressione specifica si usa il valore ",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    },
                    {
                        "id": "0,6,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,2,0",
                                "type": 4,
                                "elements": "dell'unità che si trova per primo sopra tale espressione.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "• Anche le unità integrate possono essere ridefinite.",
                                "format_id": "2d34e459-818b-4487-a1ba-7b6da48430cb"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
