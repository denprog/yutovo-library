    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo supporta variabili e funzioni personalizzate. Grazie ad esse, l'utente non è limitato ",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "alle possibilità integrate, ma può estenderle.",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Qualsiasi espressione personalizzata (variabile, funzione o unità) deve essere dichiarata prima del suo ",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "primo utilizzo.",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Per dichiarare variabili e funzioni si usa il simbolo ",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": "iVBORw0KGgoAAAANSUhEUgAAABUAAAAUCAYAAABiS3YzAAAACXBIWXMAAA7EAAAOxAGVKw4bAAAATElEQVQ4jWP8////fwYqAyZqGzhqKB0NZWRkpL6hlAIWbILISRefq3ElcayGEqMRHyBoKNVcysjICNdAjkvpl6QoLWOGeI4aNZQiAACpIBkjONXGMAAAAABJRU5ErkJggg=="
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "elements": " (scorciatoia da tastiera « : »).",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
