    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Il servizio yutovo.ru, yutovo.com (di seguito denominato Yutovo) e l'applicazione desktop non forniscono alcuna garanzia, ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "espressa o implicita, per qualsiasi scopo.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Il fornitore del servizio Yutovo e dell'applicazione desktop non assume alcuna responsabilità, finanziaria o ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "altra, per eventuali danni o perdite derivanti dall'utilizzo del servizio Yutovo o dell'applicazione ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "desktop, inclusi, ma non solo, i danni all'hardware e al software ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,3,0",
                                "type": 4,
                                "elements": "dell'Utente.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "I documenti salvati nell'account Yutovo sono privati per gli utenti ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "registrati.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Il fornitore del servizio Yutovo si riserva il diritto di utilizzare tutti i documenti caricati, i registri ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "del programma, i risultati dei calcoli e i dati immessi all'interno del servizio Yutovo, a scopo di assistenza, sviluppo e ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,2,0",
                                "type": 4,
                                "elements": "collaudo del servizio Yutovo.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Il fornitore del servizio Yutovo si riserva il diritto di modificare le presenti Condizioni d'uso in qualsiasi ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,4,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,1,0",
                                "type": 4,
                                "elements": "momento.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo del testo",
