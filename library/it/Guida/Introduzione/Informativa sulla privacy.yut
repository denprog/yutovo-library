                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "1. Informazioni raccolte",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Possiamo raccogliere informazioni personali sull'utente, come il nome, l'indirizzo e-mail, l'indirizzo IP e altre informazioni.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "2. Modalità di raccolta delle informazioni",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Possiamo raccogliere informazioni quando l'utente si registra, annulla la registrazione, accede o esce dal sito.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Possiamo raccogliere informazioni personali quando l'utente utilizza uno qualsiasi dei servizi del sito.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "3. Utilizzo delle informazioni",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Possiamo utilizzare le informazioni per verificare il vostro account sul sito web, inviando un'e-mail di conferma al vostro indirizzo e-mail registrato.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Possiamo utilizzare le informazioni personali per rispondere alle richieste degli utenti. Possiamo utilizzare le informazioni personali per migliorare i servizi, il sito web e l'applicazione desktop. Possiamo utilizzare le informazioni personali a fini di sicurezza per proteggere gli utenti e il sito web. Possiamo utilizzare le informazioni se la legge lo consente.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "4. Diritti dell'utente sui propri dati",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Potete esigere che eliminiamo qualsiasi dato personale che conserviamo su di voi. Ciò non include i dati che siamo tenuti a conservare per scopi amministrativi, legali o di sicurezza. Potete inviare una richiesta di eliminazione dei dati sul sito support@yutovo.ru.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "5. Esclusione di responsabilità",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Voi assumete l'intera responsabilità e il rischio relativi all'utilizzo del sito web, che è fornito « così com'è » senza alcuna garanzia. Le informazioni accessibili tramite il sito web, incluse, ma non solo, tutti i contenuti e i materiali, nonché le funzioni e i servizi presentati sul nostro sito web, sono tutti forniti senza alcuna garanzia, incluse, ma non solo, garanzie riguardanti la disponibilità, l'accuratezza, la completezza o l'utilità dei contenuti o delle informazioni, la continuità dell'accesso e qualsiasi garanzia di diritti di proprietà, di non violazione di diritti, di commerciabilità o di idoneità a uno scopo particolare. Non garantiamo che il nostro sito web o il suo funzionamento, nonché i contenuti e i materiali dei servizi forniti tramite esso, saranno tempestivi, sicuri, ininterrotti e privi di errori, che i difetti saranno corretti o che i nostri siti web o i server che danno accesso al nostro sito non contengano virus o altri componenti dannosi. Utilizzate il nostro sito web a vostro rischio e pericolo e vi assumete l'intera responsabilità di tutte le spese connesse all'utilizzo del sito web. Non siamo responsabili per eventuali danni legati all'utilizzo del nostro sito web.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
