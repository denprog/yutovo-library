    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo è un'applicazione per risolvere diversi problemi matematici. Yutovo ha un aspetto « cartaceo » intuitivo per i calcoli. Utilizza una sintassi matematica universalmente riconosciuta per visualizzare le formule. Yutovo è destinato a risolvere sia problemi quotidiani che ingegneristici ed è adatto a un'ampia cerchia di utenti nei settori di attività più diversi.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Yutovo utilizza una rappresentazione grafica delle formule matematiche.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
