            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "All'inserimento di un numero (stringa), il cursore assume la posizione « dentro la stringa » e prende l'aspetto di un cursore di testo. Il cursore può essere spostato con i tasti freccia in un'altra posizione dentro la stringa. Premete: [Left][Left][Left][Left][Left]. Il cursore si sposterà di cinque simboli a sinistra. Ora l'inserimento della stringa avverrà nella nuova posizione. Inserite: « 90 ».",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
