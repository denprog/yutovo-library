            {
                "id": "0,38",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,38,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,38,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Come si vede, i parametri - l'esponente della radice e il radicando - sono rimasti, si è eliminata solo la radice stessa. Analogamente si può eliminare il simbolo di divisione. Dalla posizione precedente premete [Up], per spostare il cursore sulla posizione prima del simbolo di divisione, ed eliminatelo:",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
