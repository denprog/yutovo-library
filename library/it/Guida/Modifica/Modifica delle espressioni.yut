                "level": 1,
                "elements": [
                    {
                        "id": "0,55,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,55,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Per comodità di modifica sono supportate le operazioni con gli appunti. Ciò permette di inserire rapidamente espressioni simili, copiare parti di espressioni e incollarle in altre formule.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
