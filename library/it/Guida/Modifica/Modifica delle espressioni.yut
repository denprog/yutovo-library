            },
            {
                "id": "0,46",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,46,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,46,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Prendiamo l'espressione dell'esempio precedente e dividiamola per un numero. A questo scopo prima selezioniamola con il mouse o con i tasti freccia. La selezione con i tasti freccia avviene premendo successivamente [Shift+Up] o [Shift+Down] finché tutta l'espressione non sia selezionata. Quindi premete « / » per inserire l'operazione di divisione.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
