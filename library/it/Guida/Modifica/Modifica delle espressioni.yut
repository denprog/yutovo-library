            },
            {
                "id": "0,44",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,44,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,44,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "I parametri delle operazioni possono usare un'espressione contenente altre operazioni. Per inserire tali operazioni è comodo usare la selezione di parti della formula.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,45",
                "type": 2,
                "level": 1,
