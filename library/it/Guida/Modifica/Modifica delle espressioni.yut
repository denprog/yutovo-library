            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "I tasti freccia permettono di spostarsi nelle formule. Il cursore a sinistra e a destra (tasti [Freccia sinistra] e [Freccia destra]) passa successivamente da una formula all'altra. Muovendosi in su ([Freccia su]) e in giù ([Freccia giù]) il cursore passa al ramo superiore o inferiore più vicino. Con i tasti [Ctrl]-[Freccia sinistra] e [Ctrl]-[Freccia destra] si può muovere il cursore senza entrare negli elementi annidati. Il tasto [Home] serve a riportare il cursore al ramo più generale, oppure all'inizio della riga.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Esempio:",
                                "format_id": "024d1211-a16d-4e49-9548-1753392575aa"
                            }
                        ],
                        "format_name": "Esempio"
                    }
                ],
                "format_name": "Esempio",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Nell'esempio seguente l'espressione sarà inserita dall'inizio, dalla stringa vuota.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
