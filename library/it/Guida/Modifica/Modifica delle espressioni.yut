                            {
                                "id": "0,51,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ora estraiamo la radice quadrata dall'espressione nel denominatore. Anche qui aiuta la selezione. Il cursore è nella posizione più a destra; quindi, per selezionare il denominatore, occorre premere [Shift+Left] finché tale espressione non sia interamente selezionata, oppure [Shift+Home] per selezionare tutta la stringa. Quindi inserite l'operazione di estrazione della radice premendo [Shift+Ctrl+Q].",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
