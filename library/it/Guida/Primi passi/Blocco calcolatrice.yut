    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Il blocco calcolatrice è un rettangolo nel testo per eseguire calcoli. Esso appare all'inizio di un documento vuoto e può poi essere aggiunto in qualsiasi punto del documento (tranne che dentro un blocco di codice) con il pulsante « Inserisci calcolatrice » ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " o con la combinazione di tasti [Ctrl+Shift+C]. Il blocco calcolatrice appare anche all'inizio dell'inserimento di codice con i pulsanti del pannello matematico, se il cursore non si trova in quel momento nel codice.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "I blocchi calcolatrice possono essere quanti si vuole e tra essi formano uno spazio di calcolo unico. Ciò significa in particolare che le variabili e le funzioni dichiarate in un blocco superiore possono essere usate in un blocco inferiore.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Questi blocchi si possono copiare negli appunti come qualsiasi altro simbolo. Se un'espressione matematica del blocco viene copiata nel testo, nascerà automaticamente un nuovo blocco calcolatrice.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Il testo al di fuori di questi blocchi non influenza in alcun modo i calcoli.",
                                "format_id": "5695a9fc-bfb2-400e-9cf7-a97c96761c88"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,4",
