    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ogni documento ha un insieme di impostazioni definite nella finestra Proprietà del documento, richiamata dal pulsante ",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ".",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Scheda Risultato",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ],
                        "format_name": "Titolo 4"
                    }
                ],
                "format_name": "Titolo 4",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Qui sono elencate le impostazioni predefinite per il calcolo delle espressioni.",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Selezione automatica del risultato - al momento del calcolo di un’espressione, le varianti di tipi di risultato elencate nella tabella sottostante saranno provate in successione finché l’espressione non sia calcolata con successo. Se tutte le varianti danno errori, sarà restituito l’errore della prima variante di calcolo.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ordine di selezione del risultato - in quest’ordine saranno provate le varianti di calcolo dell’espressione corrente. Il più delle volte le espressioni sono calcolate con numeri reali, quindi questa variante è la prima per impostazione predefinita. Ad esempio, per rappresentare l’espressione innanzitutto come frazione propria, mettete Frazionari al primo posto.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Reali, Interi, Frazionari, Complessi - in queste schede sono riportati i parametri predefiniti di questi risultati. In seguito essi possono essere modificati per ogni risultato tramite il menu contestuale.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Scheda Documento",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ],
                        "format_name": "Titolo 4"
                    }
                ],
                "format_name": "Titolo 4",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Lingua - la lingua corrente del documento. Da essa dipendono l’insieme delle unità e di alcune variabili. Ad esempio, per l’inglese l’unità immaginaria è « i », mentre per il russo « j ». Le unità si scrivono nella loro lingua.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Tabulazione - usare caratteri di tabulazione o un numero determinato di spazi al loro posto.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Corpo del testo"
                    }
                ],
                "format_name": "Corpo del testo",
                "format_alignment": 0,
                "marker": "•",
                "marker_format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
            },
