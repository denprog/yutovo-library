            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Uma atribuição dentro de um ramo cria uma variável local desse ramo. No exemplo, a instrução u=u+1 lê a variável externa u e grava o resultado em uma variável local, por isso u*10 dá 60. Após o cálculo, a variável externa u continua igual a 5 — a terceira linha do exemplo confirma isso.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
