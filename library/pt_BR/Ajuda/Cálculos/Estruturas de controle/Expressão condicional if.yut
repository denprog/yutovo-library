                            {
                                "id": "0,14,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Na condição e nos ramos podem ser usadas variáveis e funções declaradas anteriormente. Uma função declarada dentro de um ramo fica disponível para as instruções seguintes desse ramo e permanece depois do cálculo da expressão.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
