                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "A condição é uma comparação de duas expressões. São suportadas as operações <, >, ≤, ≥, = (igual, exibido mais destacado que o sinal de igual do cálculo) e ≠ (diferente de). A condição pode ser colocada entre parênteses. As expressões após a condição devem estar entre parênteses.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
