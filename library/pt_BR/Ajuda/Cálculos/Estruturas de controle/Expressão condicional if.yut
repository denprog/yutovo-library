            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "A condição x>0 é verdadeira, por isso o primeiro ramo é executado e o valor da expressão passa a ser x. Se x for alterado para um número negativo, a condição se tornará falsa e o segundo ramo será executado — a expressão retornará -x. Este é um exemplo de cálculo do valor absoluto de um número.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
