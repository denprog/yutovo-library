                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Para plotar um gráfico de superfície, clique no botão ",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " da barra de ferramentas Gráficos e, em seguida, insira os limites dos eixos, as expressões das superfícies e os nomes das variáveis dos eixos x e y. A expressão da superfície pode ser qualquer coisa dentro da sintaxe aceita. Os nomes das variáveis podem ser quaisquer, mas devem ser diferentes.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
