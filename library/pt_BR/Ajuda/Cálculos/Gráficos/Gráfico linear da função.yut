        "elements": [
          {
            "id": "0,0,0",
            "type": 3,
            "elements": [
              {
                "id": "0,0,0,0",
                "type": 4,
                "elements": "Para plotar um gráfico linear de uma função, clique no botão Gráficos da barra de ferramentas ",
                "format_id": "a24b77cd-c726-44a6-90b6-9f2a4d19cdfc"
              },
              {
                "id": "0,0,0,1",
                "type": 34,
                "elements": [],
                "image_base64": ""
              },
              {
                "id": "0,0,0,2",
                "type": 4,
                "elements": ", em seguida, insira os extremos do eixo, a expressão da função para o eixo y e o ",
                "format_id": "a24b77cd-c726-44a6-90b6-9f2a4d19cdfc"
              }
            ]
          },
          {
            "id": "0,0,1",
            "type": 3,
            "elements": [
              {
                "id": "0,0,1,0",
                "type": 4,
                "elements": "o parâmetro do eixo x. A expressão da função pode ser qualquer coisa dentro da sintaxe aceita. A expressão do argumento é qualquer nome de variável.",
                "format_id": "a24b77cd-c726-44a6-90b6-9f2a4d19cdfc"
              }
            ]
          }
        ],
        "format_name": "Text body",
        "format_alignment": 0
