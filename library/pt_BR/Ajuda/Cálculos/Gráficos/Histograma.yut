            {
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "type": 4,
                                "level": 1,
                                "elements": "Ao clicar no retângulo colorido perto de uma expressão, você pode alterar a cor, a espessura e o estilo de exibição do histograma correspondente: barras, barras com linha, barras sem espaços, linhas de espectrograma, área sob a linha, degraus, marcas.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6",
                                "id": "0,5,0,0"
                            }
                        ],
                        "format_name": "Corpo do texto",
                        "id": "0,5,0"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0,
                "id": "0,5"
            },
            {
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "type": 4,
                                "level": 1,
                                "elements": "Você pode redimensionar o gráfico arrastando suas bordas com o mouse. Clicar com o botão direito e selecionar o menu Formato do gráfico permite alterar a cor e o tamanho do gráfico. As barras com valores negativos são desenhadas para baixo a partir da linha zero.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6",
                                "id": "0,6,0,0"
                            }
                        ],
                        "format_name": "Corpo do texto",
