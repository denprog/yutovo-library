            "type": 3,
            "elements": [
              {
                "id": "0,5,0,0",
                "type": 4,
                "elements": "• hexadecimal - dígitos \"0\" ... \"9\" e letras \"A\" ... \"F\".",
                "format_id": "dd33cfb9-1bf4-44bf-b3c2-d89a3be6db3e"
              }
            ]
          }
        ],
        "format_name": "Text body",
        "format_alignment": 0
      },
