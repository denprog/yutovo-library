  "text": {
    "id": "0",
    "type": 1,
    "elements": [
      {
        "id": "0,0",
        "type": 2,
        "elements": [
          {
            "id": "0,0,0",
            "type": 3,
            "elements": [
              {
                "id": "0,0,0,0",
                "type": 4,
                "elements": "Inteiros são inseridos sem ponto decimal.",
                "format_id": "7e841f15-e810-4f7e-a0e7-a25ea0f20929"
              }
            ]
          }
        ],
        "format_name": "Text body",
        "format_alignment": 0
      },
      {
        "id": "0,1",
        "type": 2,
        "elements": [
          {
            "id": "0,1,0",
            "type": 3,
            "elements": [
              {
                "id": "0,1,0,0",
                "type": 4,
                "elements": "Quatro sistemas numéricos são suportados, inseridos usando os seguintes símbolos:",
                "format_id": "7e841f15-e810-4f7e-a0e7-a25ea0f20929"
              }
            ]
          }
        ],
        "format_name": "Text body",
        "format_alignment": 0
      },
      {
        "id": "0,2",
        "type": 2,
        "elements": [
          {
            "id": "0,2,0",
            "type": 3,
            "elements": [
              {
                "id": "0,2,0,0",
                "type": 4,
                "elements": "• binário - dígitos \"0\", \"1\";",
                "format_id": "dd33cfb9-1bf4-44bf-b3c2-d89a3be6db3e"
              }
            ]
          }
        ],
        "format_name": "Text body",
        "format_alignment": 0
      },
      {
        "id": "0,3",
        "type": 2,
        "elements": [
          {
            "id": "0,3,0",
            "type": 3,
            "elements": [
              {
                "id": "0,3,0,0",
                "type": 4,
                "elements": "• octal - dígitos \"0\" ... \"7\";",
                "format_id": "dd33cfb9-1bf4-44bf-b3c2-d89a3be6db3e"
              }
            ]
          }
        ],
        "format_name": "Text body",
        "format_alignment": 0
      },
      {
        "id": "0,4",
        "type": 2,
        "elements": [
          {
            "id": "0,4,0",
            "type": 3,
            "elements": [
              {
                "id": "0,4,0,0",
                "type": 4,
                "elements": "• decimal - dígitos \"0\" ... \"9\";",
                "format_id": "dd33cfb9-1bf4-44bf-b3c2-d89a3be6db3e"
              }
            ]
          }
        ],
        "format_name": "Text body",
        "format_alignment": 0
      },
      {
