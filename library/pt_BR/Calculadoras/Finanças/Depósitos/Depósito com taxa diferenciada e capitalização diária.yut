                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Uma taxa diferenciada por períodos (escalonada ao longo do tempo). A taxa (em frações de 1) é válida para um intervalo de tempo correspondente (em frações de um ano), e os juros são capitalizados no final de cada dia.ay, with a new period beginning with the capitalized amount. The sizes of the rate arrays and periods must be equal.",
                                "format_id": "aa54b796-8f3e-41c4-b0a1-033739aae4c5"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
