                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Uma taxa diferenciada por períodos (escalonada ao longo do tempo). A taxa (em frações de 1) é válida para um intervalo de tempo correspondente (em frações de um ano), e os juros são capitalizados no final de cada período.eriod. The sizes of the rate arrays and periods must be equal.",
                                "format_id": "5c440be1-d38b-4821-ac23-c4e0a011931d"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
