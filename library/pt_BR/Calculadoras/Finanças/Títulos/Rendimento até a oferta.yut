                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "A calculadora de rendimento até a oferta calcula o rendimento anual total de um título se comprado pelo preço atual, mantido até a data de resgate e reinvestindo todos os pagamentos de cupom na mesma taxa. Altere os parâmetros do depósito e o resultado será recalculado.",
                                "format_id": "fd433f2e-5ac4-445e-9748-78ae040d7cf3"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
