                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "A calculadora de rendimento efetivo, incluindo reinvestimento, calcula o rendimento total de um título, levando em conta os pagamentos de cupom e o reinvestimento (capitalização) de cupons na mesma taxa até o vencimento.l maturity. Change the parameters, and the result will be recalculated.",
                                "format_id": "bd67c614-7617-4919-b91f-155d8836c5aa"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
