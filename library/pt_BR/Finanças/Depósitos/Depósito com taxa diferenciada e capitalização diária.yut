                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Uma taxa diferenciada por períodos (escalonada ao longo do tempo). A taxa (em frações de 1) é válida para um intervalo de tempo correspondente (em frações de um ano), e os juros são capitalizados no final de cada dia., com o new período beginning com o capitalized valor.",
                                "format_id": "3d2c0abf-1df7-4da1-a701-5b08590016bb"
                            }
                        ],
                        "format_name": "Corpo do texto"
