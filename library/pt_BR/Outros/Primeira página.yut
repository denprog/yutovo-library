    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo é uma calculadora multifuncional com uma interface visual familiar e edição de operações matemáticas, combinada com um editor de texto. Ele permite realizar diversos cálculos, combinando cálculos e texto em um único documento. Após se cadastrar no ",
                                "format_id": "b7f4c544-c696-4ceb-8db6-09ffb32fea5a"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 39,
                                "elements": "site",
                                "format_id": "6359f7cb-cb92-4df7-9219-546de12b37eb",
                                "url": "https://yutovo.com"
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "elements": ", você pode salvar seus documentos na nuvem e compartilhar seus cálculos com outras pessoas.",
                                "format_id": "b7f4c544-c696-4ceb-8db6-09ffb32fea5a"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Aqui estão os principais recursos:",
                                "format_id": "b7f4c544-c696-4ceb-8db6-09ffb32fea5a"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Calcule expressões de qualquer tamanho com qualquer precisão",
                                "format_id": "2c196bb1-3283-4d92-93a2-d73b87eb7167"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 4,
                                "elements": ". Para selecionar o número de casas decimais e a ordem, clique com o botão direito no resultado e selecione \"Precisão\" ou \"Ordem\":",
                                "format_id": "c4e69609-41f6-49c6-ae39-13186d50083f"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
