                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Вычислять выражения любого размера с любой точностью. Для выбора количества знаков после запятой и порядка кликните правой кнопкой на результате и выберите \"Точность\" или \"Порядок\":",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
