    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ютово - это многофункциональный калькулятор с привычным наглядным отображением и редактированием математических операций совместно с текстовым редактором. С его помощью вы можете делать различные расчеты, объединяя вычисления и текст в одном документе. На ",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "сайте",
                                "format_id": "6359f7cb-cb92-4df7-9219-546de12b37eb",
                                "url": "https://yutovo.ru"
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " после регистрации вы сможете сохранять свои документы в облаке и обмениваться своими вычислениями с другими людьми.",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
