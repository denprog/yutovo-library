                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 39,
                                "level": 1,
                                "elements": "Вычислять выражения любого размера с любой точностью",
                                "format_id": "6359f7cb-cb92-4df7-9219-546de12b37eb",
                                "url": "../Справка/Вычисления/Изменение точности результата.yut"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 4,
                                "level": 1,
                                "elements": ". Для выбора количества знаков после запятой и порядка кликните правой кнопкой на результате и выберите \"Точность\" или \"Порядок\":",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
