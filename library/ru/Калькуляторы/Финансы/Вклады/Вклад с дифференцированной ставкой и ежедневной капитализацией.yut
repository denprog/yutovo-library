                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Дифференцированная ставка по периодам (ступенчатая во времени). Ставка (в долях от 1) действует на интервале соответствующего ",
                                "format_id": "958dacd1-015d-4c72-aa04-2c60160f3033"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "времени (в долях года) и проценты капитализируются в конце каждого дня, новый период начинается с капилизированной суммы. ",
                                "format_id": "958dacd1-015d-4c72-aa04-2c60160f3033"
                            }
                        ]
                    },
                    {
                        "id": "0,2,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,2,0",
                                "type": 4,
                                "elements": "Размеры массивов ставок и периодов должны быть равны.",
                                "format_id": "958dacd1-015d-4c72-aa04-2c60160f3033"
                            }
                        ]
                    }
                ],
