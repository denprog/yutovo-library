                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Калькулятор доходности к офёрте вычисляет общую годовая доходность облигации, при покупке по текущей цене, сохранения до даты офёрты и реинвестирования всех купонных выплат под ту же ",
                                "format_id": "bbf1806e-40a7-4248-b001-6ff7966004ef"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "ставку. Изменяйте параметры и результат будет пересчитываться.",
                                "format_id": "bbf1806e-40a7-4248-b001-6ff7966004ef"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
