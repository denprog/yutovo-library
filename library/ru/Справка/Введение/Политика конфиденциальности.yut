    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "1. Информация для сбора",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Мы можем собирать личную информацию пользователя, такую как имя, адрес электронной почты, IP-адрес и ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "другую информацию.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "2. Способы сбора информации",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Мы можем собирать информацию, когда пользователь регистрируется, отменяет регистрацию, входит или ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "выходит из системы на сайте.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Мы можем собирать личную информацию, когда пользователь использует любую из услуг сайта.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "3. Использование информации",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "Мы можем использовать информацию для проверки вашей учетной записи на веб-сайте, отправив письмо с ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,6,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,1,0",
                                "type": 4,
                                "elements": "подтверждением на ваш зарегистрированный адрес электронной почты.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "Мы можем использовать личную информацию для ответа на запросы пользователей. Мы можем использовать ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,1,0",
                                "type": 4,
                                "elements": "личную информацию для улучшения услуг, веб-сайта и настольного приложения. Мы можем использовать ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,2,0",
                                "type": 4,
                                "elements": "личную информацию в целях безопасности для защиты пользователей и веб-сайта. Мы можем использовать ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,3,0",
                                "type": 4,
                                "elements": "информацию, если это разрешено законом.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "elements": "4. Права пользователя на свои данные",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "Вы можете потребовать, чтобы мы удалили любые личные данные, которые мы храним о вас. Сюда не входят ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,1,0",
                                "type": 4,
                                "elements": "данные, которые мы обязаны хранить в административных, юридических целях или целях безопасности. ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,2,0",
                                "type": 4,
                                "elements": "Отправить запрос на удаление данных можно на сайте support@yutovo.ru.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "elements": "5. Отказ от ответственности",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "elements": "Вы принимаете на себя всю ответственность и риск в отношении использования вами веб-сайта, который ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,1,0",
                                "type": 4,
                                "elements": "предоставляется «как есть» без каких-либо гарантий. Информация, доступ к которой осуществляется с ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,2,0",
                                "type": 4,
                                "elements": "помощью веб-сайта, включая, помимо прочего, весь контент и материалы, а также функции и услуги, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,3,0",
                                "type": 4,
                                "elements": "представленные на нашем веб-сайте, все они представляются без каких-либо гарантий, включая, помимо ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,4,0",
                                "type": 4,
                                "elements": "прочего, гарантии относительно доступности, точности, полноты или полезности контента или информации, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,5,0",
                                "type": 4,
                                "elements": "бесперебойности доступа и любые гарантии прав собственности, ненарушения прав, коммерческой ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,6",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,6,0",
                                "type": 4,
                                "elements": "пригодности или пригодности для определенной цели. Мы не гарантируем, что наш веб-сайт или его ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,7",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,7,0",
                                "type": 4,
                                "elements": "функционирование, а также содержимое и материалы предоставляемых через него услуг будут ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,8",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,8,0",
                                "type": 4,
                                "elements": "своевременными, безопасными, бесперебойными и не содержать ошибок, что дефекты будут исправлены или ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,9",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,9,0",
                                "type": 4,
                                "elements": "что наши веб-сайты или серверы, обеспечивающие доступ к нашему веб-сайту, не содержат вирусов или ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,10",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,10,0",
                                "type": 4,
