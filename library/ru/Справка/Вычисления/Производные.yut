    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "type": 2,
                "level": 1,
                "format_alignment": 0,
                "format_name": "Основной текст",
                "elements": [
                    {
                        "type": 3,
                        "level": 1,
                        "format_name": "Основной текст",
                        "elements": [
                            {
                                "type": 4,
                                "level": 1,
                                "elements": "Для вычисления производной функции в числовом или символьном виде используйте соответствующие кнопки из панели Математический анализ или встроенную функцию derivative. Результат выдаётся в виде числа или символьного выражения и может быть использован для дальнейших вычислений или подстановок.",
                                "format_id": "5829edf0-64a6-4a5b-886b-39a054e345e6",
                                "id": "0,0,0,0"
                            }
                        ],
                        "id": "0,0,0"
                    }
                ],
                "id": "0,0"
            },
            {
                "type": 2,
                "level": 1,
                "format_alignment": 0,
                "format_name": "Заголовок 4",
                "elements": [
                    {
                        "type": 3,
                        "level": 1,
                        "format_name": "Заголовок 4",
                        "elements": [
                            {
                                "type": 4,
                                "level": 1,
                                "elements": "Вычисление производной с помощью дробной формы",
                                "format_id": "71b8e4a0-82b1-47a6-aadf-ef21fb5b5518",
                                "id": "0,1,0,0"
                            }
                        ],
                        "id": "0,1,0"
                    }
                ],
                "id": "0,1"
            },
            {
                "type": 2,
                "level": 1,
                "format_alignment": 0,
                "format_name": "Основной текст",
                "elements": [
                    {
                        "type": 3,
                        "level": 1,
                        "format_name": "Основной текст",
                        "elements": [
                            {
                                "type": 4,
                                "level": 1,
                                "elements": "Для первой производной функции одного аргумента нажмите кнопку ",
                                "format_id": "5829edf0-64a6-4a5b-886b-39a054e345e6",
                                "id": "0,2,0,0"
                            },
                            {
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": "",
                                "id": "0,2,0,1"
                            },
                            {
                                "type": 4,
                                "level": 1,
                                "elements": ", либо введите дробь вручную: в числителе после \"d\" укажите функцию, в знаменателе после \"d\" — переменную:",
                                "format_id": "5829edf0-64a6-4a5b-886b-39a054e345e6",
                                "id": "0,2,0,2"
                            }
                        ],
                        "id": "0,2,0"
