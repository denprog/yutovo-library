                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Условием является сравнение двух выражений. Поддерживаются операции <, >, ≤, ≥, = (равно, отображается жирнее вычислительного равно) и ≠ (не равно). Условие можно заключить в круглые скобки. Выражения после условия должны быть в круглых скобках.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
