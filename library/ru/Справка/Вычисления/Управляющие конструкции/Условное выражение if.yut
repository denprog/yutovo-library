            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ветвь — это один или несколько операторов, заключённых в круглые скобки и разделённых запятыми. Оператором может быть выражение, присваивание или объявление функции. Значением выражения if становится значение последнего оператора выполненной ветви. Ветвь не может заканчиваться объявлением функции.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
