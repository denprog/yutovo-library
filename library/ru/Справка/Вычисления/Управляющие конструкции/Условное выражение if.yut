                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Условное выражение if выполняет одну из двух ветвей в зависимости от условия. Эта управляющая конструкция возвращает значение и может использоваться внутри других выражений.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
