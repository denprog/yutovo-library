            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Присваивание внутри ветви создаёт локальную переменную этой ветви. В примере оператор u=u+1 читает внешнюю переменную u, а результат записывает в локальную переменную, поэтому u*10 даёт 60. После вычисления внешняя переменная u по-прежнему равна 5 — третья строка примера это подтверждает.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
