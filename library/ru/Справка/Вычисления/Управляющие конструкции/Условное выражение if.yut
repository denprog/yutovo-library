            },
            {
                "id": "0,14",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,14,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,14,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "В условии и ветвях можно использовать переменные и функции, объявленные ранее. Функция, объявленная внутри ветви, доступна следующим операторам этой ветви и сохраняется после вычисления выражения.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
