            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Условие x>0 истинно, поэтому выполняется первая ветвь и значением выражения становится x. Если изменить x на отрицательное число, условие станет ложным и выполнится вторая ветвь — выражение вернёт -x. Это пример вычисления абсолютного значения числа.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
