            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Переменная u объявлена перед циклом и равна 0. Присваивание u=u+i накапливает сумму: при первой итерации правая часть читает внешнюю переменную u, в следующих итерациях — накопленное значение.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,11",
