                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Операторы тела цикла",
                                "format_id": "71b8e4a0-82b1-47a6-aadf-ef21fb5b5518"
                            }
                        ],
                        "format_name": "Заголовок 4"
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,12",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Тело цикла может содержать выражения, присваивания и объявления функций. Присваивание создаёт локальную переменную цикла: внешняя переменная с тем же именем после цикла не изменяется, а счётчик и локальные переменные после цикла не существуют. Функция, объявленная в теле, доступна следующим операторам тела и сохраняется после цикла. Последний оператор тела не может быть объявлением функции; пустое тело недопустимо.",
                                "format_id": "16bf1dac-0c4c-4866-99a7-05c3e8fccc3d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
