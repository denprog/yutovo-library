    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Каждый документ имеет набор настроек, которые задаются в диалоге Свойств документа, вызываемого кнопкой ",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "elements": ".",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Вкладка Результат",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ]
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Здесь перечислены настройки по умолчанию для вычисления выражений.",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Вещественные, Целые, Дробные, Комплексные - на этих вкладках представлены параметры этих результатов по умолчанию. В ",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "дальнейшем их можно менять для каждого результата путем выбора из контексного меню.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Вкладка Документ",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ]
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• Язык - текущий язык документа. От него зависят набор размерностей и некоторых переменных. Например, для английского языка ",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ]
                    },
                    {
                        "id": "0,5,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,1,0",
                                "type": 4,
                                "elements": "мнимая единица - это \"i\", а для русского - \"j\". Размерности пишутся на своем языке.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "• Табуляция - использовать символы табуляции или определенное количество пробелов взамен этого.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
