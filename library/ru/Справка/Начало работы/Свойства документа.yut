                                "elements": "Вкладка Подключенные документы",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ]
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "elements": "Здесь задается список ",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            },
                            {
                                "id": "0,8,0,1",
                                "type": 39,
                                "elements": "подключенных документов",
                                "format_id": "e1c1c7a8-e26c-451b-b297-39cc2fc981b6",
                                "url": "../Вычисления/Подключаемые документы.yut"
                            },
                            {
                                "id": "0,8,0,2",
                                "type": 4,
                                "elements": ", которые используются данным документом.",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
